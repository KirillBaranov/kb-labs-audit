{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@kb-labs/audit-contracts": [
        "packages/audit-contracts/src/index.ts"
      ],
      "@kb-labs/audit-contracts/*": [
        "packages/audit-contracts/src/*"
      ],
      "@kb-labs/audit-core": [
        "packages/audit-core/src/index.ts"
      ],
      "@kb-labs/audit-core/*": [
        "packages/audit-core/src/*"
      ],
      "@kb-labs/cli-commands": [
        "../kb-labs-cli/packages/cli-commands/src/index.ts"
      ],
      "@kb-labs/cli-commands/*": [
        "../kb-labs-cli/packages/cli-commands/src/*"
      ],
      "@kb-labs/cli-core": [
        "../kb-labs-cli/packages/cli-core/src/index.ts"
      ],
      "@kb-labs/cli-core/*": [
        "../kb-labs-cli/packages/cli-core/src/*"
      ],
      "@kb-labs/core": [
        "../kb-labs-core/src/index.ts"
      ],
      "@kb-labs/core/*": [
        "../kb-labs-core/src/*"
      ],
      "@kb-labs/plugin-contracts": [
        "../kb-labs-plugin/packages/plugin-contracts/src/index.ts"
      ],
      "@kb-labs/plugin-contracts/*": [
        "../kb-labs-plugin/packages/plugin-contracts/src/*"
      ],
      "@kb-labs/plugin-manifest": [
        "../kb-labs-plugin/packages/plugin-manifest/src/index.ts"
      ],
      "@kb-labs/plugin-manifest/*": [
        "../kb-labs-plugin/packages/plugin-manifest/src/*"
      ],
      "@kb-labs/shared-cli-ui": [
        "../kb-labs-shared/packages/shared-cli-ui/src/index.ts"
      ],
      "@kb-labs/shared-cli-ui/*": [
        "../kb-labs-shared/packages/shared-cli-ui/src/*"
      ],
      "@kb-labs/shared-command-kit": [
        "../kb-labs-shared/packages/shared-command-kit/src/index.ts"
      ],
      "@kb-labs/shared-command-kit/*": [
        "../kb-labs-shared/packages/shared-command-kit/src/*"
      ]
    }
  }
}
